    <worksheet name='Total PU Zones'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#172b4d' fontname='Arial' fontsize='14'>Trips by Pickup Zone</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1+ (Multiple Connections)' name='federated.1of5qwy1lvzizt124hanf1bfigtt' />
          </datasources>
          <datasource-dependencies datasource='federated.1of5qwy1lvzizt124hanf1bfigtt'>
            <column caption='Time of Day' datatype='string' name='[Calculation_0856852483194881]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=4 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=10&#13;&#10;THEN&quot;MORNING&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=11 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=16&#13;&#10;THEN&quot;AFTERNOON&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=17 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=21&#13;&#10;THEN&quot;EVENING&quot;&#13;&#10;ELSE&quot;Late Night&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Zone]' role='dimension' type='nominal' />
            <column caption='Green Tip' datatype='table' name='[__tableau_internal_object_id__].[Sheet1_B2618D9B52EC4B8FB946B4A95BDB8200]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[Sheet1_B2618D9B52EC4B8FB946B4A95BDB8200]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:Sheet1_B2618D9B52EC4B8FB946B4A95BDB8200:qk]' pivot='key' type='quantitative' />
            <column caption='Lpep Pickup Datetime' datatype='datetime' name='[lpep_pickup_datetime]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0856852483194881]' derivation='None' name='[none:Calculation_0856852483194881:nk]' pivot='key' type='nominal' />
            <column-instance column='[Zone]' derivation='None' name='[none:Zone:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1of5qwy1lvzizt124hanf1bfigtt].[none:Calculation_0856852483194881:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_0856852483194881:nk]' member='&quot;AFTERNOON&quot;' />
              <groupfilter function='member' level='[none:Calculation_0856852483194881:nk]' member='&quot;EVENING&quot;' />
              <groupfilter function='member' level='[none:Calculation_0856852483194881:nk]' member='&quot;Late Night&quot;' />
              <groupfilter function='member' level='[none:Calculation_0856852483194881:nk]' member='&quot;MORNING&quot;' />
